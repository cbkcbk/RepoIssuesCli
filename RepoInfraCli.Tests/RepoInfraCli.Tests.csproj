<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="NUnit" Version="4.3.2" />
        <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
        <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
        <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
        <PackageReference Include="Testcontainers" Version="4.16.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
        <Using Include="RepoCli.Core.Cli" />
        <Using Include="RepoCli.Core.Features.Repo" />
        <Using Include="RepoCli.Core.Features.Validation" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <Compile Remove="Cli/Plugin/**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../RepoInfraCli/RepoInfraCli.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Cloud\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="DropTmdsSshPublicApiAnalyzers" AfterTargets="ResolveLockFileAnalyzers">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.CodeAnalysis.PublicApiAnalyzers'" />
        </ItemGroup>
    </Target>

</Project>
