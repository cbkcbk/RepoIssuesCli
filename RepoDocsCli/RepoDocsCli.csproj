<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RollForward>Major</RollForward>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <PropertyGroup>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>docs</ToolCommandName>
        <PackageId>RepoDocsCli</PackageId>
        <Version>0.1.0</Version>
        <Description>Agent docs (CLAUDE.md-style) stored as YAML feature files inside your repository (.repo-docs). Condense docs, find the relevant ones and prune stale ones.</Description>
        <PackageTags>docs;claude;agents;cli;git;dotnet-tool</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageOutputPath>$(MSBuildThisFileDirectory)../nupkg</PackageOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <Compile Remove="Cli/Plugin/**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../RepoCli.Core/RepoCli.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="RepoCli.Core.Cli" />
        <Using Include="RepoCli.Core.Features.Repo" />
        <Using Include="RepoCli.Core.Features.Validation" />
    </ItemGroup>

</Project>
